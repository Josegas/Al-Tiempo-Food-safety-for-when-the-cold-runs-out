# Copy to .env and fill in. Never commit .env.
AWS_REGION=us-east-1
# After `make dev-profile`, use the least-privilege profile for chat/evals:
# AWS_PROFILE=al-tiempo
# Cheap Bedrock model available in your account/region (inference profile id)
MODEL_ID=us.amazon.nova-2-lite-v1:0
DEMO_MODE=true
# Dev only: lets the engine use rules not yet verified on their official source
ALLOW_UNVERIFIED_RULES=false
TABLE_NAME=al-tiempo
SMS_ENABLED=false
DEFAULT_TIMEZONE=America/Mazatlan

# Admin-only: email for budget and alarm alerts (needed to deploy AlTiempoAccess)
ALERT_EMAIL=
